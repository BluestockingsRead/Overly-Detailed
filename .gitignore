# ===================================================================
# 📁 Directory Defaults
# ===================================================================

# Nothing is tracked unless explicitly allowed below.
*


# ===================================================================
# ⚙️ Repository Files
# ===================================================================

!.gitignore
!.gitattributes
!LICENSE


# ===================================================================
# 📝 Documentation
# ===================================================================

!README.md

# Public documentation.
# The parent directory must be unignored before its contents.
!docs/
!docs/**/


# Greasy Fork listing information.
!docs/greasyfork.md


# ===================================================================
# 📜 Userscript
# ===================================================================

!OverlyDetailed.user.js


# ===================================================================
# 🌐 Live Demo
# ===================================================================

# Served from GitHub Pages. The shim stands in for the
# userscript-manager APIs so index.html can run the real script.
!index.html
!gm-shim.js


# ===================================================================
# 🧐 Stress Test
# ===================================================================

# Developer test fixture.
!stress-test.html


# ===================================================================
# 🎨 Styles, Icon & Fonts
# ===================================================================

# Shared look for the demo & stress-test pages.
!styles.css

# Tab icon for both pages. Adapts to light and dark on its own.
!favicon.svg

# Self-hosted so neither page reaches out to a CDN.
# The parent directory must be unignored before its contents.
!fonts/
!fonts/**/

!fonts/fonts.css
!fonts/*.woff2
!fonts/licenses/*.txt