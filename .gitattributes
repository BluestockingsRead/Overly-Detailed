# ===================================================================
# ↩️ Line endings
# ===================================================================
# LF in the repo and LF on checkout, regardless of anyone's local
# core.autocrlf. Without this, the userscript keeps flip-flopping
# between CRLF and LF and every edit shows up as a whole-file rewrite.

* text=auto eol=lf


# ===================================================================
# 🔤 Fonts
# ===================================================================
# Binary files, so the line-ending rule above has no business here.
# Git's auto-detection gets this right anyway; saying it out loud
# means a stray misconfiguration can't corrupt a woff2 on checkout.

*.woff2 binary
